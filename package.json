{
  "name": "wordrealm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "词域 — 背单词 + AI 语法题",
  "scripts": {
    "etl": "node tools/etl.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:lock": "node tools/check-lock.mjs",
    "test:fsrs": "node --experimental-strip-types tools/test-fsrs.mts",
    "test:grammar": "node --import ./tools/ts-loader.mjs --experimental-strip-types tools/test-grammar.mts",
    "test:words": "node --import ./tools/ts-loader.mjs --experimental-strip-types tools/test-integration.mts",
    "test:grammar-int": "node --import ./tools/ts-loader.mjs --experimental-strip-types tools/test-grammar-integration.mts",
    "test": "npm run typecheck && npm run check:lock && npm run test:fsrs && npm run test:grammar && npm run test:words && npm run test:grammar-int"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
